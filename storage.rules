rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Permitir lectura pública a los comprobantes de SUNAT (XML, CDR, PDF)
    match /sunat/{allPaths=**} {
      allow read: if true;  // Cualquier persona con el link puede descargarlo
      allow write: if request.auth != null; 
    }
    
    // Regla por defecto para el resto de tus archivos (seguridad estándar)
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    
  }
}